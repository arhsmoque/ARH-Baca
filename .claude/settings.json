{
  "extraKnownMarketplaces": {
    "arh-cloud-agent-toolkit": {
      "source": {
        "source": "github",
        "repo": "arhsmoque/arh-cloud-agent-toolkit"
      }
    }
  },
  "enabledPlugins": {
    "cloud-agent-toolkit@arh-cloud-agent-toolkit": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
