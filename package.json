{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "arh-baca",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint resources/js/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "secrets:check": "secretlint \"**/*\"",
    "check": "node scripts/check.mjs",
    "check:quick": "node scripts/check.mjs --quick",
    "baca": "node scripts/baca.mjs",
    "dev:doctor": "node scripts/doctor.mjs",
    "dev:readiness": "node scripts/doctor.mjs --network",
    "secrets:sync": "node scripts/sync-secrets.mjs",
    "secrets:sync:dry-run": "node scripts/sync-secrets.mjs --dry-run",
    "test:e2e:install": "pnpm exec playwright install --with-deps chromium",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:ui": "pnpm exec playwright test --ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.62.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.4",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "fontaine": "^0.8.0",
    "globals": "^17.9.0",
    "husky": "^9.1.0",
    "laravel-vite-plugin": "^3.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.5.0",
    "secretlint": "^13.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.0"
  },
  "lint-staged": {
    "*.php": "vendor/bin/pint",
    "*.{js,mjs,cjs,ts,css,json,md,yaml,yml}": "prettier --check",
    "**/*": "secretlint"
  }
}
